cat > ../.gitignore <<'EOF'
# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Prisma generated files
**/src/generated/prisma/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Development tool files
.agents/
.claude/
.windsurf/
skills-lock.json
EOF